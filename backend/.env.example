# Set these only when creating the system-managed staff users for a fresh database.
OPS_MANAGER_PASSWORD=replace_with_a_unique_password
PLATFORM_ADMIN_PASSWORD=replace_with_a_unique_password
SUPPORT_AGENT_PASSWORD=replace_with_a_unique_password

# Optional document upload integration.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
